<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FEtHEr.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FEtHEr">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="FetherPageBackgroundBrush" Color="HotPink" />
                    <SolidColorBrush x:Key="FetherPrimaryTextBrush" Color="Navy" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="FetherPageBackgroundBrush" Color="Navy" />
                    <SolidColorBrush x:Key="FetherPrimaryTextBrush" Color="HotPink" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
